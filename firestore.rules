rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isStudentOrFaculty() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['student', 'faculty'];
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create: if isSelf(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role in ['student', 'faculty', 'parent', 'admin'];
      allow read: if isSelf(userId) || isAdmin();
      allow update: if isAdmin() || (isSelf(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /departments/{departmentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /library_books/{bookId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /placements/{placementId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /lost_found/{itemId} {
      allow read: if isAdmin() || (signedIn() &&
        (resource.data.status == 'approved' ||
          resource.data.reportedByUserId == request.auth.uid));
      allow create: if isAdmin() || (isStudentOrFaculty() &&
        request.resource.data.reportedByUserId == request.auth.uid &&
        request.resource.data.status == 'pending');
      allow update: if isAdmin() || (isStudentOrFaculty() &&
        resource.data.reportedByUserId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.reportedByUserId == resource.data.reportedByUserId &&
        request.resource.data.status == 'pending');
      allow delete: if isAdmin() || (isStudentOrFaculty() &&
        resource.data.reportedByUserId == request.auth.uid &&
        resource.data.status == 'pending');
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /notification_jobs/{jobId} {
      allow create: if isAdmin() &&
        request.resource.data.type == 'announcement' &&
        request.resource.data.announcementId == jobId &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
